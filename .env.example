PORT=5000

# Paystack Configuration
# Get these from https://dashboard.paystack.com/#/settings/developer
PAYSTACK_SECRET_KEY=sk_test_demo_mode
PAYSTACK_PUBLIC_KEY=pk_test_demo_mode

# Instant Notification: Telegram Bot (Recommended, 100% Free)
# 1. Message @BotFather on Telegram to create a bot and get token
# 2. Get your Chat ID by messaging @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Instant Notification: WhatsApp (Optional - Twilio or UltraMsg)
# If left blank, system generates direct one-click WhatsApp (wa.me) links!
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
WHATSAPP_VENDOR_PHONE=+2348000000000

# Google Sheets Sync
# Option A: Simple Apps Script Webhook URL (Easiest - see google-apps-script.js)
GOOGLE_SHEET_WEBHOOK_URL=

# Option B: Official Google Sheets API (Service Account)
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
